{
	"name": "solid-i18next",
	"version": "0.0.5",
	"type": "module",
	"description": "i18next integration for Solid.js with reactive hooks, a Trans component, and built-in Suspense support",
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
		"dev": "vite",
		"build": "tsc && node ./build.ts",
		"vite:build": "tsc && vite build",
		"vite:preview": "vite preview",
		"check": "biome check",
		"test": "vitest run",
		"test:watch": "vitest",
		"release": "pnpm run build && pnpm publish --access public ./dist"
	},
	"peerDependencies": {
		"i18next": "^25.8.13 || ^26.0.0",
		"solid-js": "^1.9.11"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.11",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.4.0",
		"i18next": "^26.4.0",
		"i18next-resources-to-backend": "^1.2.3",
		"solid-js": "^1.9.15",
		"tailwindcss": "^4.3.3",
		"tsdown": "^0.22.14",
		"typescript": "^6.0.3",
		"vite": "^8.2.2",
		"vite-plugin-solid": "^2.11.14",
		"vitest": "^4.1.11"
	},
	"license": "MIT",
	"author": "Lukas Heizmann <lukas@heizmann.dev>",
	"homepage": "https://github.com/lkwr/solid-i18next#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lkwr/solid-i18next.git"
	},
	"bugs": {
		"url": "https://github.com/lkwr/solid-i18next/issues"
	},
	"keywords": [
		"solid",
		"solidjs",
		"solid-js",
		"i18next",
		"i18n",
		"internationalization",
		"translation"
	],
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "26.8.1",
			"onFail": "download"
		}
	}
}
